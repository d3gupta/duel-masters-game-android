{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duel-masters-game-android.local/schemas/card-catalog.schema.json",
  "title": "Duel Masters Offline Card Catalog",
  "type": "object",
  "required": ["catalogVersion", "language", "cards"],
  "properties": {
    "catalogVersion": { "type": "integer", "minimum": 1 },
    "language": { "const": "en" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "object",
      "required": ["firstSet", "lastSet", "includesPromos"],
      "properties": {
        "firstSet": { "type": "string" },
        "lastSet": { "type": "string" },
        "includesPromos": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cardId", "name", "type", "civilizations", "cost", "rulesText", "mechanics", "implementationStatus", "provenance", "printings"],
        "properties": {
          "cardId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["CREATURE", "EVOLUTION_CREATURE", "SPELL", "CROSS_GEAR", "CASTLE", "OTHER"] },
          "civilizations": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["LIGHT", "WATER", "DARKNESS", "FIRE", "NATURE"] }
          },
          "cost": { "type": ["integer", "null"], "minimum": 0 },
          "power": { "type": ["string", "null"], "description": "Keep as text to preserve variable and modified power notation." },
          "races": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "rulesText": { "type": "string" },
          "flavorText": { "type": ["string", "null"] },
          "mechanics": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "implementationStatus": { "enum": ["METADATA_ONLY", "PARTIAL", "IMPLEMENTED", "RULES_VERIFIED"] },
          "effectDefinitionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "provenance": {
            "type": "object",
            "required": ["sourceName", "sourceUrl", "language", "releaseClass"],
            "properties": {
              "sourceName": { "type": "string" },
              "sourceUrl": { "type": "string", "format": "uri" },
              "sourceRecordId": { "type": ["string", "null"] },
              "language": { "const": "en" },
              "releaseClass": { "enum": ["OFFICIAL_ENGLISH", "COMMUNITY_ENGLISH_VERSION", "PROMOTIONAL", "UNVERIFIED"] },
              "verifiedAt": { "type": ["string", "null"], "format": "date" },
              "notes": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "printings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["setCode", "collectorNumber", "rarity"],
              "properties": {
                "setCode": { "type": "string" },
                "setName": { "type": ["string", "null"] },
                "collectorNumber": { "type": "string" },
                "rarity": { "type": ["string", "null"] },
                "illustrator": { "type": ["string", "null"] },
                "releaseClass": { "enum": ["OFFICIAL_ENGLISH", "COMMUNITY_ENGLISH_VERSION", "PROMOTIONAL", "UNVERIFIED"] },
                "imageAssetKey": { "type": ["string", "null"] },
                "sourceUrl": { "type": ["string", "null"], "format": "uri" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
